# Every setting Concourse reads. Each comes from ENV under Rails' name
# (SERVICE__KEY) or, when unset, from encrypted credentials (service.key).
# Copy this file to .env: in development Rails reads it itself for settings,
# and foreman (bin/dev) exports it to the processes it starts. The test suite
# never reads .env. Under a bare bin/rails, export process knobs in the shell.

# Public origin of this deployment; agent tokens must name it as audience.
APP__URL=http://localhost:3000

# OIDC sign-in for people.
OIDC__ISSUER=
OIDC__CLIENT_ID=
OIDC__CLIENT_SECRET=
OIDC__CALLBACK_URI=http://localhost:3000/auth/ajent/callback

# Organizations: "open" lets signed-in people create one, "closed" (the
# default) leaves that to the console. The default organization is the
# platform's own, for the system user and concourse/conformance. The legacy
# organization, if any, is where card addresses without an organization in
# them redirect.
CONCOURSE__ORGANIZATION_CREATION=closed
CONCOURSE__DEFAULT_ORGANIZATION=concourse
CONCOURSE__LEGACY_ORGANIZATION=
# Process selector (not an encrypted setting): legacy default 1; isolated v3 3.
# Export CONCOURSE__RELEASE_LINE=3 before Rails loads credentials to select
# config/credentials/v3.yml.enc with v3.key or standard RAILS_MASTER_KEY.
# Do not use production.yml.enc for v3: Rails would also select it for legacy.
# CONCOURSE__RELEASE_LINE=1

# Confidential client for RFC 7662 token introspection at the same issuer.
INTROSPECTION__CLIENT_ID=
INTROSPECTION__CLIENT_SECRET=

# Optional. Concourse's own confidential client at the same issuer for minting
# one client per agent joined through /connect. Blank turns /connect off.
AJENT__AGENT_CLIENTS_CLIENT_ID=
AJENT__AGENT_CLIENTS_CLIENT_SECRET=

# Native relay foundation: settings alone cannot activate this partial binary.
# New work selection and outbound traffic both remain hard unavailable.
RELAY__ENABLED=false
RELAY__OUTBOUND_ENABLED=false
# Dedicated Ajent machine grant; never the inbound caller's token.
RELAY__AJENT_TOKEN_URL=
# Exact Ajent RFC 8414 URL required for native public-card verification.
RELAY__AJENT_OAUTH2_METADATA_URL=
RELAY__RELAY_CLIENT_ID=
RELAY__RELAY_CLIENT_SECRET=
# Operator-only JSON array of exact organization_id, recipient_id, endpoint_url,
# card_url and resource tuples (optional exact tenant); no wildcard/private routes.
RELAY__ALLOWED_ENDPOINTS=[]

# Optional. Error tracking (required in production), product analytics, and
# Web Push alerts (off unless both keys are set).
GLITCHTIP__DSN=
RYBBIT__SITE_ID=
# Your Rybbit host, for example https://rybbit.example.com.
RYBBIT__HOST=
VAPID__PUBLIC_KEY=
VAPID__PRIVATE_KEY=
# Contact for push services; defaults to APP__URL.
VAPID__SUBJECT=
# Optional. Email alerts to owners when someone waits for approval. Off unless
# SMTP__ADDRESS, SMTP__USERNAME, SMTP__PASSWORD and SMTP__FROM are all set.
SMTP__ADDRESS=
# Defaults to 587 (STARTTLS).
SMTP__PORT=
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM=

# Optional: Active Record encryption keys for agent push tokens (PushConfig#token).
# Rails reads these itself. When unset, keys are derived from secret_key_base
# (config/initializers/active_record_encryption.rb), so nothing is required.
# ACTIVE_RECORD_ENCRYPTION__PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION__DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION__KEY_DERIVATION_SALT=

# Process knobs, not settings: they tune how a process runs rather than what
# Concourse is, so they are read straight from ENV under the names Rails, Solid
# Queue, Falcon and OpenTelemetry already use, never from credentials.
# Commented out; unset means the value shown.
# RAILS_MAX_THREADS=8
# RAILS_LOG_LEVEL=info
# JOB_CONCURRENCY=1
# PORT=3000
# FALCON_BIND=http://0.0.0.0:3000
# FALCON_COUNT=1
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=concourse
# OTEL_RESOURCE_ATTRIBUTES=
# DEPLOYMENT_ENVIRONMENT=development

# Test harness only: bin/a2a-tck and the backup test point a test-env process
# at a throwaway database and the TCK server's own origin.
# CONCOURSE_DATABASE=storage/test.sqlite3
# A2A_TCK_APP_URL=https://concourse.example.com
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
