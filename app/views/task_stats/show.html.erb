<% content_for :title, t(".title") %>
<% content_for :without_analytics, "true" %>
<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<header class="max-w-3xl">
  <h1 class="page-title"><%= t(".title") %></h1>
  <p class="page-lead"><%= t(".lead") %></p>
</header>

<%= form_with url: task_stats_path(Current.organization), method: :get, data: { turbo: false }, class: "mt-6 flex flex-wrap items-end gap-4" do |f| %>
  <div>
    <%= f.label :from, t(".from"), class: "block text-sm" %>
    <%= f.date_field :from, value: @from, required: true, class: "field" %>
  </div>
  <div>
    <%= f.label :through, t(".through"), class: "block text-sm" %>
    <%= f.date_field :through, value: @through, required: true, class: "field" %>
  </div>
  <%= f.submit t(".show"), class: "btn-primary" %>
<% end %>

<% if response.status == 422 %>
  <p role="alert" class="mt-3 text-sm text-stop-400"><%= t(".invalid_range") %></p>
<% end %>

<% if @summary %>
  <p class="meta mt-4"><%= t(".coverage", cutoff: @cutoff.iso8601) %></p>
  <section class="mt-8 overflow-x-auto" aria-labelledby="message-counts-title">
    <h2 id="message-counts-title" class="section-title"><%= t(".messages") %></h2>
    <p class="meta"><%= t(".message_state") %></p>
    <table id="message-counts" class="mt-3 w-full text-left text-sm">
      <thead class="text-ink-300">
        <tr>
          <% %w[day sender state count].each do |column| %>
            <th scope="col" class="px-2 py-2"><%= t(".columns.#{column}") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @counts.each do |row| %>
          <tr class="border-t border-edge/[0.09]">
            <td class="px-2 py-2 tabular-nums"><%= row["day"] %></td>
            <td class="px-2 py-2"><%= row["agent"] || t(".unknown_agent") %></td>
            <td class="px-2 py-2"><%= row["state"]&.delete_prefix("TASK_STATE_")&.humanize || t(".unknown_state") %></td>
            <td class="px-2 py-2 tabular-nums"><%= row["count"] %></td>
          </tr>
        <% end %>
        <% if @counts.empty? %>
          <tr><td colspan="4" class="px-2 py-2"><%= t(".no_messages") %></td></tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <section class="mt-8 max-w-3xl" aria-labelledby="task-summary-title">
    <h2 id="task-summary-title" class="section-title"><%= t(".outcomes") %></h2>
    <p class="meta"><%= t(".outcome_coverage") %></p>
    <dl class="mt-3 grid gap-x-4 gap-y-2 text-sm sm:grid-cols-[1fr_auto]">
      <% %w[repeated_input completed completed_without_text first_reply_measured first_reply_missing first_reply_median_ms first_reply_p95_ms].each do |key| %>
        <dt><%= t(".metrics.#{key}") %></dt>
        <dd id="<%= key.delete_suffix("_ms").dasherize %>" class="tabular-nums">
          <% if key.end_with?("_ms") %>
            <%= @summary[key] ? t(".seconds", value: number_with_precision(@summary[key] / 1000.0, precision: 3)) : t(".unavailable") %>
          <% else %>
            <%= @summary[key] %>
          <% end %>
        </dd>
      <% end %>
    </dl>
  </section>
<% end %>
